+def select_split(parquet_paths, split):
+    """
+    CS182 curvature-Muon project: four-way split of the downloaded shards (sorted by name).
+    - val   = last shard            (hyperparameter selection, model comparison)
+    - test  = second-to-last shard  (reserved for final evaluation only)
+    - fresh = third-to-last shard   (fresh minibatches for the diagnostic experiments)
+    - train = all remaining shards  (optimization; also tokenizer training)
+    """
+    assert split in ["train", "val", "test", "fresh"], f"unknown split {split}"
+    assert len(parquet_paths) >= 4, "need at least 4 shards for train/fresh/test/val"
+    if split == "train":
+        return parquet_paths[:-3]
+    if split == "fresh":
+        return parquet_paths[-3:-2]
+    if split == "test":
+        return parquet_paths[-2:-1]
+    return parquet_paths[-1:]
+
